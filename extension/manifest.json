{
  "manifest_version": 3,
  "name": "Hush",
  "version": "2.0.0",
  "description": "Captures tab video frames and controls tab audio for the Hush ad-muting system.",
  "permissions": [
    "tabCapture",
    "tabs",
    "offscreen"
  ],
  "host_permissions": [
    "http://localhost:9099/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-grey-16.png",
      "48": "icons/icon-grey-48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-grey-16.png",
    "48": "icons/icon-grey-48.png",
    "128": "icons/icon-grey-128.png"
  }
}
